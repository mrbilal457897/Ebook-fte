# E-book FTE — required environment variables (placeholders only)
# Copy to `.env` and fill in real values. `.env` is git-ignored (AGENTS.md §5).
# NEVER commit real secrets.

# --- Postgres system of record (AGENTS.md §8) ---
DATABASE_URL=postgres://user:password@localhost:5432/ebookfte

# --- Model/provider config (AGENTS.md §5, Article VII) ---
# Default platform model for the Orchestrator agent (Gemini via ADK).
ORCHESTRATOR_MODEL=gemini-flash-latest
# Default model for the Content Agent.
CONTENT_AGENT_MODEL=gemini-flash-latest
# Default model for the Cover Design Agent.
COVER_DESIGN_AGENT_MODEL=gemini-flash-latest
# Default model for the Formatting Agent.
FORMATTING_AGENT_MODEL=gemini-flash-latest
# Default model for the Publishing Advisor Agent.
PUBLISHING_ADVISOR_AGENT_MODEL=gemini-flash-latest
# Gemini/ADK platform API key (long-lived platform credential for free-tier
# requests; BYOK customer keys live in `model_credentials`, never here).
GOOGLE_API_KEY=replace-with-gemini-platform-key

# --- BYOK (Principle 3: customer connects their own provider key) ---
# 32-byte AES-256-GCM key that seals every BYOK key in `model_credentials`. The
# frontend writes (frontend/lib/model-credentials.ts) and the Orchestrator reads
# (agents/orchestrator/src/orchestrator/byok.py) — both need the SAME value.
# Generate with: openssl rand -base64 32
# Without it, saving a BYOK key fails closed with `byok_not_configured` rather
# than falling back to storing the key in the clear.
BYOK_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Per-provider model used when a customer's own key is active. A Gemini model
# name is not valid for OpenAI/Anthropic, so each provider is configured
# separately rather than reusing CONTENT_AGENT_MODEL.
BYOK_GEMINI_MODEL=gemini-flash-latest
BYOK_OPENAI_MODEL=gpt-4.1-mini
BYOK_ANTHROPIC_MODEL=claude-sonnet-4-5
# Development-only escape hatch that lets the Orchestrator read a `dev:`-prefixed
# PLAINTEXT key row, so a developer can hand-seed one without running the
# frontend. MUST stay 0 outside local development: a non-boolean value is
# rejected outright rather than defaulting to "allow".
ALLOW_PLAINTEXT_BYOK=0

# --- Internal service auth ---
# Short-lived token the Next.js proxy presents to the Orchestrator
# (contracts/orchestrator-api.md). Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=replace-with-openssl-rand-hex-32
# Base URL of the Orchestrator service the Next.js proxy forwards /api/generate
# to, e.g. http://localhost:8000
ORCHESTRATOR_URL=http://localhost:8000

# --- Custom MCP servers (AGENTS.md §7) ---
# Base URL of the ebook-data MCP server (stateless streamable HTTP). The
# specialist agents reach shared book data (books, content_versions,
# cover_assets, formatting_jobs, publishing_records) through this server, never
# by direct SQL — see specs/002-ebook-data-mcp/spec.md §7. The Orchestrator's
# streaming persistence is the one recorded exception.
EBOOK_DATA_URL=http://localhost:8081/mcp
# The server's own default is 8000, which collides with ORCHESTRATOR_URL above.
# Set this explicitly whenever both run on one host.
EBOOK_DATA_PORT=8081

# --- Free-tier + lease (defaults match the spec: 3 free generations) ---
# Per-account free-generation cap (FR-007); enforcement reads it at runtime.
FREE_TIER_LIMIT=3
# In-flight lease window in seconds (FR-009); renewed per streamed chunk.
LEASE_WINDOW_SECONDS=60

# --- Per-device/IP rate limits (FR-002; values config-driven, tuned later) ---
RATE_LIMIT_DEVICE_MAX=10
RATE_LIMIT_IP_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Generation params (configurable per task type, not hard-coded) ---
# Defaults shown; override per environment / per task type via *_TEMPERATURE,
# *_TOP_P, *_MAX_TOKENS for the `default` and `book_content` task types.
GENERATION_TEMPERATURE=0.8
GENERATION_TOP_P=0.95
GENERATION_MAX_TOKENS=8192
BOOK_CONTENT_TEMPERATURE=0.8
BOOK_CONTENT_TOP_P=0.95
BOOK_CONTENT_MAX_TOKENS=8192

# --- Better Auth (frontend, ratified 2026-09-19) ---
# Session signing/encryption secret, MINIMUM 32 chars. openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-char-min-random-secret
# Dedicated session encryption/rotation key used by the Better Auth
# configuration in frontend/lib/auth/ (T009). openssl rand -base64 32
AUTH_SESSION_ENCRYPTION_KEY=replace-with-32-char-min-random-key
# Public origin of the Next.js app, used by Better Auth for callbacks and
# redirects, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (T009): create OAuth client credentials in Google Cloud Console
# (Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# --- Lago billing (subscription + invoicing logic; NOT a payment processor) ---
# Lago sits on top of a licensed gateway (Stripe). Card capture happens on the
# gateway's hosted page; nothing here handles a PAN.
LAGO_API_URL=http://localhost:3001/api/v1
LAGO_API_KEY=replace-with-lago-api-key
# Plan code in Lago that an upgrade moves a customer to. Checked at request
# time — without it /api/upgrade refuses rather than guessing a plan.
LAGO_PLAN_CODE=pro
# HMAC Signature Token for the billing webhook endpoint (Lago: Developers >
# Webhooks). REQUIRED: /api/billing/webhook returns 503 without it rather than
# accepting unsigned billing events, which could grant a paid tier.
# Set the endpoint's signature algorithm to HMAC, not the JWT default.
LAGO_WEBHOOK_HMAC_KEY=replace-with-lago-webhook-hmac-token